{
	"name": "saffron-shark-labs",
	"version": "3.1.0",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git@github.com:ichbindev/saffron-shark-labs.git"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview --port 4322",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"typecheck": "astro check",
		"test": "vitest run test/unit test/components",
		"test:watch": "vitest test/unit test/components",
		"test:build": "vitest run test/build",
		"check": "npm run lint && npm run typecheck && npm run test",
		"prepare": "simple-git-hooks"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/mdx": "^7.0.8",
		"@astrojs/sitemap": "^3.7.3",
		"@iconify-json/ic": "^1.2.4",
		"@iconify-json/mdi": "^1.2.3",
		"astro": "^7.2.9",
		"astro-icon": "^1.2.0",
		"linkedom": "^0.18.13",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"pretty-quick": "^4.2.2",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"simple-git-hooks": {
		"pre-commit": "npx pretty-quick --staged"
	}
}
