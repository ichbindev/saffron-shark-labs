{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		"baseUrl": "src",
		"types": ["astro/client"],
		"paths": {
			"@components/*": ["components/*"],
			"@config/*": ["config/*"],
			"@layouts/*": ["layouts/*"],
			"@pages/*": ["pages/*"],
			"@styles/*": ["styles/*"],
			"@utils/*": ["utils/*"]
		}
	},
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "node_modules"]
}
