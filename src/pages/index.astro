---
import { getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { Button } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import TextAndImageHero from '../components/sections/heros/TextAndImageHero.astro';
import dayImage from '../assets/images/home/day.jpeg';
import nightImage from '../assets/images/home/night.jpeg';

const seo = {
	title: 'Saffron Shark Labs',
	description: 'Software Development and Consulting Services',
};

/*
 * The hero art follows the theme, so both variants are optimized at build time
 * and the generated URLs are handed to the theme switcher through a data
 * attribute. That keeps the hashed asset paths out of theme-switcher.ts, which
 * has no way to know them.
 */
const HERO_WIDTH = 1200;

const [day, night] = await Promise.all([
	getImage({ src: dayImage, width: HERO_WIDTH, format: 'webp' }),
	getImage({ src: nightImage, width: HERO_WIDTH, format: 'webp' }),
]);

const heroVariants = {
	default: { src: day.src, alt: 'Swimming shark in the daytime' },
	dark: { src: night.src, alt: 'Swimming shark at night' },
};
---

<Layout {seo}>
	<TextAndImageHero reversed>
		<div slot="text-container">
			<h1>Saffron Shark Labs</h1>
			<p>
				Need help getting your startup off the ground? We provide expert
				guidance and innovative solutions to turn your ideas into reality.
			</p>
		</div>
		<div slot="btns-container">
			<Button href="/company/contact" customIcon
				>Reach out today <Fragment slot="icon">
					<Icon name="ic:baseline-chevron-right" />
				</Fragment></Button
			>
		</div>
		<picture slot="image-container">
			<img
				id="home-hero-image"
				src={heroVariants.default.src}
				alt={heroVariants.default.alt}
				width={day.attributes.width}
				height={day.attributes.height}
				fetchpriority="high"
				decoding="async"
				data-theme-variants={JSON.stringify(heroVariants)}
			/>
		</picture>
	</TextAndImageHero>
</Layout>
