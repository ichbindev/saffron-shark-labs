<!--
  Runs before first paint so the page never flashes the wrong palette.
  Mirrors the fallback logic in theme-switcher.ts: stored choice first,
  then the OS preference. Must stay `is:inline` so it is not bundled
  and deferred.
-->
<script is:inline>
	const doc = document.firstElementChild;
	const storedTheme = localStorage.getItem('theme');
	const prefersDark =
		window.matchMedia &&
		window.matchMedia('(prefers-color-scheme: dark)').matches;

	doc.setAttribute(
		'data-theme',
		storedTheme ?? (prefersDark ? 'dark' : 'default'),
	);
</script>
