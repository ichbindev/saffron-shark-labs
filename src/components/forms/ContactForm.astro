---
import { Button, FormInput, FormSelect, FormTextarea } from '@components/odyssey-theme';

const selectOptions = [
  "Google Search",
  "LinkedIn",
  "Referral (include details in message!)",
]

---

<form name="Contact Form" method="POST" action="https://www.formbackend.com/f/a87d3fbfb9e67690">
  <FormInput type="text" label="Username" id="Username" name="Username" autocomplete="username" placeholder="JohnDoe69" />
  <FormInput type="text" label="Name" name="Name" id="Name" autocomplete="name" placeholder="John Doe" />
  <FormInput type="email" label="Email" name="Email" id="Email" autocomplete="email" placeholder="hello@example.com" />
  <FormSelect label="How Did You Hear About Us?" name="HowDidYouHearAboutUs" id="HowDidYouHearAboutUs" options={selectOptions} />
  <FormTextarea label="Message" name="Message" id="Message" placeholder="Your message here..." />
  <Button>Submit</Button>
</form>

<style>
  form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  :global(label[for="Username"]) {
    display: none;
  }
  :global(#Username) {
    display: none;
  }

</style>